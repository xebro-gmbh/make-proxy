# RENDERED via envsubst (official nginx image) — source:
# docker/proxy/templates/default.conf.template. The app bundles know their
# own routes: <bundle>.install drops a snippet into docker/config/proxy/
# (see include below). The proxy itself is app-agnostic.

server {
    listen 80;
    server_name ${XO_SERVER_NAME};

    # healthcheck without redirect (busybox wget would follow it nowhere)
    location = /healthz {
        access_log off;
        return 200;
    }

    location / {
        # XO_PROXY_TLS_SUFFIX is ":<port>" when the TLS port is not 443
        # (multi-instance setups) — $host would drop the port.
        return 301 https://$host${XO_PROXY_TLS_SUFFIX}$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${XO_SERVER_NAME};

    # emit relative redirects so the client keeps its origin including a
    # non-default published port (e.g. :4443 in multi-instance setups)
    absolute_redirect off;

    ssl_certificate     /etc/nginx/certs/local.crt;
    ssl_certificate_key /etc/nginx/certs/local.key;

    client_max_body_size 64m;

    include /etc/nginx/conf.d/routes/*.conf;
}
